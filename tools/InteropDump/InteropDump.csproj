<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lists types, fields and method signatures of an interop assembly that BepInEx generated
       (BepInEx/interop/Assembly-CSharp.dll). Reads the metadata only, loads and runs nothing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
